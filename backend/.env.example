# Copy this file to .env and fill in the values.
# Backend = Supabase project (Auth + Database + Storage). No standalone server;
# the API lives in the Next.js app (frontend/app/api).

# Supabase project (Project Settings > API)
SUPABASE_URL=
# Publishable (anon) key — safe for the browser, used by the frontend.
SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Bypasses row-level security. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string — used by the Supabase CLI for migrations.
SUPABASE_DB_URL=
